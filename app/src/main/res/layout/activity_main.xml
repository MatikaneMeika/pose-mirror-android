<?xml version="1.0" encoding="utf-8"?>
<!--
  Main screen: the viewfinder is the hero. Quiet chrome top (wordmark + status
  pill), one slim control strip, then the live results grid. The setup panel
  overlays everything only during first-run bootstrap.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Viewfinder -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.15">

            <androidx.camera.view.PreviewView
                android:id="@+id/previewView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Top chrome: wordmark left, status pill right -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/sp2"
                android:paddingTop="@dimen/sp2"
                android:paddingEnd="@dimen/sp2">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/space_grotesk"
                    android:letterSpacing="0.08"
                    android:text="pose-mirror"
                    android:textColor="@color/ink"
                    android:textSize="@dimen/text_title"
                    android:textStyle="bold" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp">

                    <View
                        android:id="@+id/statusDot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/dot" />

                    <TextView
                        android:id="@+id/statusText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/status_init"
                        android:textColor="@color/muted"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- Control strip: one row, hairline-separated -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/control_strip_h"
            android:background="@color/surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/sp1"
            android:paddingEnd="@dimen/sp1">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mirrorBtn"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target"
                android:checkable="true"
                android:contentDescription="@string/mirror_desc"
                android:text="@string/mirror_label"
                android:textSize="@dimen/text_body"
                app:icon="@drawable/ic_mirror" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/settingsBtn"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/settings_desc"
                android:src="@drawable/ic_settings"
                app:tint="@color/ink" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/hairline_w"
            android:background="@color/hairline" />

        <!-- Results -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/resultsGrid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:padding="6dp" />

            <!-- Skeleton while the model/index warms up -->
            <GridLayout
                android:id="@+id/skeletonView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:columnCount="3"
                android:padding="6dp"
                android:visibility="gone">

                <View
                    android:layout_width="0dp"
                    android:layout_height="@dimen/thumb_h"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:background="@drawable/bg_skeleton" />
                <View
                    android:layout_width="0dp"
                    android:layout_height="@dimen/thumb_h"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:background="@drawable/bg_skeleton" />
                <View
                    android:layout_width="0dp"
                    android:layout_height="@dimen/thumb_h"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:background="@drawable/bg_skeleton" />
                <View
                    android:layout_width="0dp"
                    android:layout_height="@dimen/thumb_h"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:background="@drawable/bg_skeleton" />
                <View
                    android:layout_width="0dp"
                    android:layout_height="@dimen/thumb_h"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:background="@drawable/bg_skeleton" />
                <View
                    android:layout_width="0dp"
                    android:layout_height="@dimen/thumb_h"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:background="@drawable/bg_skeleton" />
            </GridLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- First-run setup overlay -->
    <FrameLayout
        android:id="@+id/setupScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scrim"
        android:visibility="gone">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="@dimen/sp3"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="@dimen/corner_m"
            app:strokeColor="@color/hairline"
            app:strokeWidth="@dimen/hairline_w">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="@dimen/sp3">

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/setupLottie"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="true"
                    app:lottie_rawRes="@raw/dl_arrow" />

                <TextView
                    android:id="@+id/setupTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sp2"
                    android:fontFamily="@font/space_grotesk"
                    android:text="@string/setup_title"
                    android:textColor="@color/ink"
                    android:textSize="@dimen/text_title"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/setupBody"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sp1"
                    android:gravity="center"
                    android:text="@string/setup_body"
                    android:textColor="@color/muted"
                    android:textSize="@dimen/text_body" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/setupProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sp2"
                    android:indeterminate="true"
                    app:indicatorColor="@color/gold"
                    app:trackColor="@color/surface2" />

                <TextView
                    android:id="@+id/setupStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sp1"
                    android:textColor="@color/muted"
                    android:textSize="@dimen/text_caption" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/urlField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sp2"
                    android:hint="@string/url_hint"
                    app:boxStrokeColor="@color/hairline"
                    app:hintTextColor="@color/faint"
                    android:visibility="gone">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/urlInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textUri"
                        android:textColor="@color/ink"
                        android:textColorHint="@color/faint"
                        android:textSize="@dimen/text_body" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sp2"
                    android:gravity="end"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/setupSecondaryBtn"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/touch_target"
                        android:text="@string/setup_manual"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/setupPrimaryBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/touch_target"
                        android:layout_marginStart="@dimen/sp1"
                        android:text="@string/retry" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>
</FrameLayout>
