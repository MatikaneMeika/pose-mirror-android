<?xml version="1.0" encoding="utf-8"?>
<!-- Result detail bottom sheet: large preview + attribution + actions. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface"
    android:orientation="vertical"
    android:padding="@dimen/sp2">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/sp2"
        android:background="@drawable/bg_skeleton" />

    <ImageView
        android:id="@+id/detailThumb"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="@drawable/bg_skeleton"
        android:clipToOutline="true"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sp2"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/detailTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/ink"
            android:textSize="@dimen/text_title" />

        <TextView
            android:id="@+id/detailScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/sp2"
            android:fontFamily="@font/space_grotesk"
            android:textColor="@color/gold_bright"
            android:textSize="@dimen/text_display"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/detailMeta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sp1"
        android:textColor="@color/muted"
        android:textSize="@dimen/text_caption" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sp2"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pinBtn"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target"
            app:icon="@drawable/ic_star_filled" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sourceBtn"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target"
            android:layout_marginStart="@dimen/sp1"
            android:text="@string/view_source"
            app:icon="@drawable/ic_open" />
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="@dimen/sp2" />
</LinearLayout>
